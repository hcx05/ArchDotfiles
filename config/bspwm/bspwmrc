# Set environment variables
export PATH="$HOME/.config/bspwm/bin:$PATH"
export XDG_CURRENT_DESKTOP='bspwm'
## Fix java applications
export _JAVA_AWT_WM_NONREPARENTING=1
## Input method (ibus + chewing / Zhuyin) -- Super+i toggles
export GTK_IM_MODULE=ibus
export QT_IM_MODULE=ibus
export XMODIFIERS=@im=ibus
export SDL_IM_MODULE=ibus
export GLFW_IM_MODULE=ibus

#  ╦ ╦╔═╗╦═╗╦╔═╔═╗╔═╗╔═╗╔═╗╔═╗╔═╗
#  ║║║║ ║╠╦╝╠╩╗╚═╗╠═╝╠═╣║  ║╣ ╚═╗
#  ╚╩╝╚═╝╩╚═╩ ╩╚═╝╩  ╩ ╩╚═╝╚═╝╚═╝

bspc config remove_disabled_monitors true
bspc config remove_unplugged_monitors true
bspc config merge_overlapping_monitors true
MonitorSetup

#  ╔╦╗╦╔═╗╔═╗╦  ╔═╗╦ ╦  ╔═╗╔═╗╔═╗╦  ╔═╗
#   ║║║╚═╗╠═╝║  ╠═╣╚╦╝  ╚═╗║  ╠═╣║  ║╣
#  ═╩╝╩╚═╝╩  ╩═╝╩ ╩ ╩   ╚═╝╚═╝╩ ╩╩═╝╚═╝

# One scale factor for the whole rice, derived from the screen that is
# actually there (see ~/.config/rice/scale/autoscale + scale.conf). Detect it
# now -- after MonitorSetup picked the mode, before anything is sized -- and
# publish it: Xft.dpi for every toolkit's text, RICE_SCALE / scale_px for the
# pixel sizes below, in the theme modules, and in the polybar / rofi / eww
# shims in ~/.config/bspwm/bin.
# --no-hook: the hook restarts bspwm, i.e. runs this very file.
"$HOME"/.config/rice/scale/autoscale apply --no-hook
. "$HOME"/.config/rice/scale/scale-lib.sh

#  ╔╗ ╔═╗╔═╗╦ ╦╔╦╗  ╔═╗╔═╗╔╗╔╔═╗╦╔═╗
#  ╠╩╗╚═╗╠═╝║║║║║║  ║  ║ ║║║║╠╣ ║║ ╦
#  ╚═╝╚═╝╩  ╚╩╝╩ ╩  ╚═╝╚═╝╝╚╝╚  ╩╚═╝

bspc config external_rules_command "${HOME}"/.config/bspwm/bin/ExternalRules

bspc config window_gap                "$(scale_px 5)"
bspc config split_ratio               0.51
bspc config single_monocle            true

bspc config automatic_scheme          longest_side
bspc config initial_polarity          second_child
bspc config removal_adjustment        true

bspc config focus_follows_pointer     true
bspc config pointer_follows_focus     false
bspc config pointer_follows_monitor   true
bspc config pointer_motion_interval   7
bspc config pointer_modifier          mod4
bspc config pointer_action1           move
bspc config pointer_action2           resize_side
bspc config pointer_action3           resize_corner

#  ╔═╗╦ ╦╔╦╗╔═╗╔═╗╔╦╗╔═╗╦═╗╔╦╗
#  ╠═╣║ ║ ║ ║ ║╚═╗ ║ ╠═╣╠╦╝ ║
#  ╩ ╩╚═╝ ╩ ╚═╝╚═╝ ╩ ╩ ╩╩╚═ ╩

run() {
  if ! pidof -q "$1"; then
    "$@" &
  fi
}

# Set system vars for polybar
"$HOME"/.config/bspwm/bin/SetSysVars

# Launch sxhkd daemon
run sxhkd -c "${HOME}"/.config/bspwm/config/sxhkdrc

# Load current theme
"${HOME}"/.config/bspwm/bin/Theme.sh

# Keep following the screen: when the VM window is resized the guest gets a
# new preferred mode (nothing applies that under a bare WM -- the watcher
# does) and the scale is re-derived; on a change it restarts bspwm so this
# file re-applies every size. Single instance: a restart cannot stack them.
"$HOME"/.config/rice/scale/autoscale watch &

# Launch picom
run picom --config "${HOME}"/.config/bspwm/config/picom/picom.conf

# Launch xsettingsd
run xsettingsd --config="${HOME}"/.config/bspwm/config/xsettingsd >/dev/null 2>&1

# Launch eww daemon
pidof -q eww || { eww -c "${HOME}"/.config/bspwm/eww daemon & }

# Launch clipboard daemon
run clipcatd

# VMware guest agent: host <-> guest clipboard copy/paste and drag & drop
command -v vmware-user-suid-wrapper >/dev/null && ! pgrep -f '^[^ ]*vmtoolsd -n vmusr' >/dev/null \
    && vmware-user-suid-wrapper &

# Launch input method (Super+i toggles chewing via toggle-ibus.sh)
pidof -q ibus-daemon || ibus-daemon -drx

# Tap Right Shift = toggle input method (bound to XF86Launch1 in sxhkdrc)
command -v xcape >/dev/null && { pkill -x xcape; xcape -e 'Shift_R=XF86Launch1'; }

# Clipboard history daemon from the i3 rice (Super+v opens the picker).
# Self-guards with a flock, so a bspwm reload can't stack daemons.
python3 "$HOME"/.config/rice/clipboard/clipd.py &

# Launch polkit
run lxpolkit

# The event to make Layouts work with polybar
bspc subscribe desktop_focus monitor_focus | while read -r _; do
    polybar-msg action "#layout.hook.0" >/dev/null 2>&1
done &

# Start one time message
[ ! -f "$HOME/.config/bspwm/config/.first_run_done" ] && eww -c ${HOME}/.config/bspwm/eww open --toggle welcome && touch "$HOME/.config/bspwm/config/.first_run_done"
