#!/bin/sh
# Toggle: enlarge the focused window by a fixed step; press again to shrink back.
STATE_DIR="/tmp/ToggleMax"
DX=50
DY=25
mkdir -p "$STATE_DIR"

wid=$(bspc query -N -n focused) || exit 1
[ -z "$wid" ] && exit 1

mark="$STATE_DIR/$wid"
if [ -f "$mark" ]; then
    bspc node "$wid" -z top_left $DX $DY
    bspc node "$wid" -z bottom_right -$DX -$DY
    rm -f "$mark"
else
    bspc node "$wid" -z top_left -$DX -$DY
    bspc node "$wid" -z bottom_right $DX $DY
    : > "$mark"
fi
