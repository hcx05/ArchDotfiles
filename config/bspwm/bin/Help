#!/bin/sh

# help — rofi-rendered keybind cheatsheet, parsed from sxhkdrc.
# Section headers use the color of HEADER_KEY from shared.rasi.
# Keybind names are bold, no fixed color — text follows the theme's foreground.
# Press Alt+l inside the menu to toggle English / Traditional Chinese.

SXHKDRC="$HOME/.config/bspwm/config/sxhkdrc"
I18N="$HOME/.config/bspwm/config/keybind-i18n.tsv"
THEME="$HOME/.config/bspwm/config/rofi-themes/keybinds.rasi"
SHARED="$HOME/.config/bspwm/config/rofi-themes/shared.rasi"
HEADER_KEY="active"
LANG_STATE="$HOME/.cache/bspwm-help-lang"

[ -r "$SXHKDRC" ] || { notify-send "help" "sxhkdrc not found: $SXHKDRC"; exit 1; }

mkdir -p "$(dirname "$LANG_STATE")"
LANG_NOW=$(cat "$LANG_STATE" 2>/dev/null)
case "$LANG_NOW" in
    zh) ;;
    *) LANG_NOW="en" ;;
esac

# From shared.rasi: header color (first hex on HEADER_KEY) and font family
# (the font string minus its trailing size). Both fall back below if missing.
ACCENT=$(sed -n "s/^[[:space:]]*${HEADER_KEY}[[:space:]]*:[[:space:]]*\(#[0-9a-fA-F]\{6\}\).*/\1/p" "$SHARED" 2>/dev/null | head -n 1)
FONT=$(sed -n 's/^[[:space:]]*font[[:space:]]*:[[:space:]]*"\(.*\) [0-9][0-9.]*".*/\1/p' "$SHARED" 2>/dev/null | head -n 1)

if [ "$LANG_NOW" = "zh" ]; then
    PROMPT="快捷鍵 (Alt+l 切換 EN)"
else
    PROMPT="Keybindings (Alt+l 切中文)"
fi

LIST=$(awk -v accent="${ACCENT:-#7aa2f7}" -v lang="$LANG_NOW" -v i18n="$I18N" '
    BEGIN {
        if (lang == "zh" && i18n != "") {
            while ((getline line < i18n) > 0) {
                n = index(line, "\t")
                if (n > 0) {
                    en = substr(line, 1, n - 1)
                    zh = substr(line, n + 1)
                    tr[en] = zh
                }
            }
            close(i18n)
        }
    }

    function xmlesc(s) {
        gsub(/&/, "\\&amp;", s)
        gsub(/</, "\\&lt;", s)
        gsub(/>/, "\\&gt;", s)
        return s
    }

    function tl(s) {
        if (lang == "zh" && (s in tr)) return tr[s]
        return s
    }

    # Section marker: # -- NAME -- #
    /^#[[:space:]]*--[[:space:]]+.+[[:space:]]+-- #[[:space:]]*$/ {
        sub(/^#[[:space:]]*--[[:space:]]+/, "")
        sub(/[[:space:]]+-- #[[:space:]]*$/, "")
        printf "<span size=\"large\" weight=\"bold\" foreground=\"%s\">── %s ──</span>\n", accent, xmlesc(tl($0))
        last = ""
        next
    }

    # Regular comment → buffer as description
    /^#/ { sub(/^#[[:space:]]*/, ""); last = $0; next }

    # Keybind line (starts with a letter, including XF86 / Print)
    /^[[:alpha:]]/ && last != "" { printf "<b>%-30s</b>  %s\n", xmlesc($0), xmlesc(tl(last)) }

    # Anything else (including a keybind just printed) clears the buffer
    { last = "" }
' "$SXHKDRC")

printf "%s\n" "$LIST" | rofi -dmenu -markup-rows -i -p "$PROMPT" -theme "$THEME" \
    -theme-str "* { font: \"${FONT:-JetBrainsMono NF Bold} 10\"; }" \
    -kb-custom-1 "Alt+l"
rc=$?

if [ "$rc" -eq 10 ]; then
    if [ "$LANG_NOW" = "zh" ]; then
        echo "en" > "$LANG_STATE"
    else
        echo "zh" > "$LANG_STATE"
    fi
    exec "$0"
fi
